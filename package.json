{
  "name": "j-hunt",
  "version": "0.1.0",
  "description": "Local-first job hunting management CLI",
  "type": "module",
  "bin": {
    "j-hunt": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun build ./src/cli.ts --compile --outfile ./dist/j-hunt"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.6",
    "typescript": "latest"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
